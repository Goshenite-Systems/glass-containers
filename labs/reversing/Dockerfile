# syntax=docker/dockerfile:1
# Goshenite lab: reversing
# Base: Kali rolling. Installs kali-tools-reverse-engineering so the reversing bundle's
# unpackaged (non-Fedora) tools are reachable via `distrobox enter reversing`.
# Auto-generated by generate-labs.py — do not edit by hand.
FROM kalilinux/kali-rolling:latest

ENV DEBIAN_FRONTEND=noninteractive \
    GOSHENITE_LAB=reversing

RUN apt-get update && apt-get install -y --no-install-recommends \
        kali-tools-reverse-engineering ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# distrobox may already be present in the Kali base; install if available, ignore otherwise.
RUN apt-get update && (apt-get install -y --no-install-recommends distrobox || true) \
    && rm -rf /var/lib/apt/lists/*

# Goshenite marker + convenience alias file for distrobox-exported shells.
RUN mkdir -p /usr/share/goshenite \
    && echo '{"lab":"reversing","kali_tools":"kali-tools-reverse-engineering"}' > /usr/share/goshenite/lab-info.json \
    && printf '# Goshenite reversing lab\nalias goshenite-lab="echo reversing (kali-tools-reverse-engineering)"\n' > /etc/profile.d/goshenite-reversing-alias.sh

CMD ["/bin/bash"]
