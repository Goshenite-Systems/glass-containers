# syntax=docker/dockerfile:1
# Goshenite lab: respond
# Base: Kali rolling. Installs kali-tools-respond so the respond bundle's
# unpackaged (non-Fedora) tools are reachable via `distrobox enter respond`.
# Auto-generated by generate-labs.py — do not edit by hand.
FROM kalilinux/kali-rolling:latest

ENV DEBIAN_FRONTEND=noninteractive \
    GOSHENITE_LAB=respond

RUN apt-get update && apt-get install -y --no-install-recommends \
        kali-tools-respond ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# distrobox may already be present in the Kali base; install if available, ignore otherwise.
RUN apt-get update && (apt-get install -y --no-install-recommends distrobox || true) \
    && rm -rf /var/lib/apt/lists/*

# Goshenite marker + convenience alias file for distrobox-exported shells.
RUN mkdir -p /usr/share/goshenite \
    && echo '{"lab":"respond","kali_tools":"kali-tools-respond"}' > /usr/share/goshenite/lab-info.json \
    && printf '# Goshenite respond lab\nalias goshenite-lab="echo respond (kali-tools-respond)"\n' > /etc/profile.d/goshenite-respond-alias.sh

CMD ["/bin/bash"]
