# syntax=docker/dockerfile:1
# Goshenite lab: recover
# Base: Kali rolling. Installs kali-tools-recover so the recover bundle's
# unpackaged (non-Fedora) tools are reachable via `distrobox enter recover`.
# Auto-generated by generate-labs.py — do not edit by hand.
FROM kalilinux/kali-rolling:latest

ENV DEBIAN_FRONTEND=noninteractive \
    GOSHENITE_LAB=recover

RUN apt-get update && apt-get install -y --no-install-recommends \
        kali-tools-recover ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# distrobox may already be present in the Kali base; install if available, ignore otherwise.
RUN apt-get update && (apt-get install -y --no-install-recommends distrobox || true) \
    && rm -rf /var/lib/apt/lists/*

# Goshenite marker + convenience alias file for distrobox-exported shells.
RUN mkdir -p /usr/share/goshenite \
    && echo '{"lab":"recover","kali_tools":"kali-tools-recover"}' > /usr/share/goshenite/lab-info.json \
    && printf '# Goshenite recover lab\nalias goshenite-lab="echo recover (kali-tools-recover)"\n' > /etc/profile.d/goshenite-recover-alias.sh

CMD ["/bin/bash"]
