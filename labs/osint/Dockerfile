# syntax=docker/dockerfile:1
# Goshenite lab: osint
# Base: Kali rolling. Installs kali-tools-information-gathering so the osint bundle's
# unpackaged (non-Fedora) tools are reachable via `distrobox enter osint`.
# Auto-generated by generate-labs.py — do not edit by hand.
FROM kalilinux/kali-rolling:latest

ENV DEBIAN_FRONTEND=noninteractive \
    GOSHENITE_LAB=osint

RUN apt-get update && apt-get install -y --no-install-recommends \
        kali-tools-information-gathering ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# distrobox may already be present in the Kali base; install if available, ignore otherwise.
RUN apt-get update && (apt-get install -y --no-install-recommends distrobox || true) \
    && rm -rf /var/lib/apt/lists/*

# Goshenite marker + convenience alias file for distrobox-exported shells.
RUN mkdir -p /usr/share/goshenite \
    && echo '{"lab":"osint","kali_tools":"kali-tools-information-gathering"}' > /usr/share/goshenite/lab-info.json \
    && printf '# Goshenite osint lab\nalias goshenite-lab="echo osint (kali-tools-information-gathering)"\n' > /etc/profile.d/goshenite-osint-alias.sh

CMD ["/bin/bash"]
