# syntax=docker/dockerfile:1
# Goshenite lab: windows
# Base: Kali rolling. Installs kali-tools-windows-resources so the windows bundle's
# unpackaged (non-Fedora) tools are reachable via `distrobox enter windows`.
# Auto-generated by generate-labs.py — do not edit by hand.
FROM kalilinux/kali-rolling:latest

ENV DEBIAN_FRONTEND=noninteractive \
    GOSHENITE_LAB=windows

RUN apt-get update && apt-get install -y --no-install-recommends \
        kali-tools-windows-resources ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# distrobox may already be present in the Kali base; install if available, ignore otherwise.
RUN apt-get update && (apt-get install -y --no-install-recommends distrobox || true) \
    && rm -rf /var/lib/apt/lists/*

# Goshenite marker + convenience alias file for distrobox-exported shells.
RUN mkdir -p /usr/share/goshenite \
    && echo '{"lab":"windows","kali_tools":"kali-tools-windows-resources"}' > /usr/share/goshenite/lab-info.json \
    && printf '# Goshenite windows lab\nalias goshenite-lab="echo windows (kali-tools-windows-resources)"\n' > /etc/profile.d/goshenite-windows-alias.sh

CMD ["/bin/bash"]
