# syntax=docker/dockerfile:1
# Goshenite lab: protect
# Base: Kali rolling. Installs kali-tools-protect so the protect bundle's
# unpackaged (non-Fedora) tools are reachable via `distrobox enter protect`.
# Auto-generated by generate-labs.py — do not edit by hand.
FROM kalilinux/kali-rolling:latest

ENV DEBIAN_FRONTEND=noninteractive \
    GOSHENITE_LAB=protect

RUN apt-get update && apt-get install -y --no-install-recommends \
        kali-tools-protect ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# distrobox may already be present in the Kali base; install if available, ignore otherwise.
RUN apt-get update && (apt-get install -y --no-install-recommends distrobox || true) \
    && rm -rf /var/lib/apt/lists/*

# Goshenite marker + convenience alias file for distrobox-exported shells.
RUN mkdir -p /usr/share/goshenite \
    && echo '{"lab":"protect","kali_tools":"kali-tools-protect"}' > /usr/share/goshenite/lab-info.json \
    && printf '# Goshenite protect lab\nalias goshenite-lab="echo protect (kali-tools-protect)"\n' > /etc/profile.d/goshenite-protect-alias.sh

CMD ["/bin/bash"]
