# syntax=docker/dockerfile:1
# Goshenite lab: database
# Base: Kali rolling. Installs kali-tools-database so the database bundle's
# unpackaged (non-Fedora) tools are reachable via `distrobox enter database`.
# Auto-generated by generate-labs.py — do not edit by hand.
FROM kalilinux/kali-rolling:latest

ENV DEBIAN_FRONTEND=noninteractive \
    GOSHENITE_LAB=database

RUN apt-get update && apt-get install -y --no-install-recommends \
        kali-tools-database ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# distrobox may already be present in the Kali base; install if available, ignore otherwise.
RUN apt-get update && (apt-get install -y --no-install-recommends distrobox || true) \
    && rm -rf /var/lib/apt/lists/*

# Goshenite marker + convenience alias file for distrobox-exported shells.
RUN mkdir -p /usr/share/goshenite \
    && echo '{"lab":"database","kali_tools":"kali-tools-database"}' > /usr/share/goshenite/lab-info.json \
    && printf '# Goshenite database lab\nalias goshenite-lab="echo database (kali-tools-database)"\n' > /etc/profile.d/goshenite-database-alias.sh

CMD ["/bin/bash"]
