# syntax=docker/dockerfile:1
# Goshenite lab: wireless
# Base: Kali rolling. Installs kali-tools-wireless so the wireless bundle's
# unpackaged (non-Fedora) tools are reachable via `distrobox enter wireless`.
# Auto-generated by generate-labs.py — do not edit by hand.
FROM kalilinux/kali-rolling:latest

ENV DEBIAN_FRONTEND=noninteractive \
    GOSHENITE_LAB=wireless

RUN apt-get update && apt-get install -y --no-install-recommends \
        kali-tools-wireless ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# distrobox may already be present in the Kali base; install if available, ignore otherwise.
RUN apt-get update && (apt-get install -y --no-install-recommends distrobox || true) \
    && rm -rf /var/lib/apt/lists/*

# Goshenite marker + convenience alias file for distrobox-exported shells.
RUN mkdir -p /usr/share/goshenite \
    && echo '{"lab":"wireless","kali_tools":"kali-tools-wireless"}' > /usr/share/goshenite/lab-info.json \
    && printf '# Goshenite wireless lab\nalias goshenite-lab="echo wireless (kali-tools-wireless)"\n' > /etc/profile.d/goshenite-wireless-alias.sh

CMD ["/bin/bash"]
