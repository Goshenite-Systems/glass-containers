# syntax=docker/dockerfile:1
# Goshenite lab: social-engineering
# Base: Kali rolling. Installs kali-tools-social-engineering so the social-engineering bundle's
# unpackaged (non-Fedora) tools are reachable via `distrobox enter social-engineering`.
# Auto-generated by generate-labs.py — do not edit by hand.
FROM kalilinux/kali-rolling:latest

ENV DEBIAN_FRONTEND=noninteractive \
    GOSHENITE_LAB=social-engineering

RUN apt-get update && apt-get install -y --no-install-recommends \
        kali-tools-social-engineering ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# distrobox may already be present in the Kali base; install if available, ignore otherwise.
RUN apt-get update && (apt-get install -y --no-install-recommends distrobox || true) \
    && rm -rf /var/lib/apt/lists/*

# Goshenite marker + convenience alias file for distrobox-exported shells.
RUN mkdir -p /usr/share/goshenite \
    && echo '{"lab":"social-engineering","kali_tools":"kali-tools-social-engineering"}' > /usr/share/goshenite/lab-info.json \
    && printf '# Goshenite social-engineering lab\nalias goshenite-lab="echo social-engineering (kali-tools-social-engineering)"\n' > /etc/profile.d/goshenite-social-engineering-alias.sh

CMD ["/bin/bash"]
