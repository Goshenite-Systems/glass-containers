# syntax=docker/dockerfile:1
# Goshenite lab: passwords
# Base: Kali rolling. Installs kali-tools-passwords so the passwords bundle's
# unpackaged (non-Fedora) tools are reachable via `distrobox enter passwords`.
# Auto-generated by generate-labs.py — do not edit by hand.
FROM kalilinux/kali-rolling:latest

ENV DEBIAN_FRONTEND=noninteractive \
    GOSHENITE_LAB=passwords

RUN apt-get update && apt-get install -y --no-install-recommends \
        kali-tools-passwords ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# distrobox may already be present in the Kali base; install if available, ignore otherwise.
RUN apt-get update && (apt-get install -y --no-install-recommends distrobox || true) \
    && rm -rf /var/lib/apt/lists/*

# Goshenite marker + convenience alias file for distrobox-exported shells.
RUN mkdir -p /usr/share/goshenite \
    && echo '{"lab":"passwords","kali_tools":"kali-tools-passwords"}' > /usr/share/goshenite/lab-info.json \
    && printf '# Goshenite passwords lab\nalias goshenite-lab="echo passwords (kali-tools-passwords)"\n' > /etc/profile.d/goshenite-passwords-alias.sh

CMD ["/bin/bash"]
