# syntax=docker/dockerfile:1
# Goshenite lab: voip
# Base: Kali rolling. Installs kali-tools-voip so the voip bundle's
# unpackaged (non-Fedora) tools are reachable via `distrobox enter voip`.
# Auto-generated by generate-labs.py — do not edit by hand.
FROM kalilinux/kali-rolling:latest

ENV DEBIAN_FRONTEND=noninteractive \
    GOSHENITE_LAB=voip

RUN apt-get update && apt-get install -y --no-install-recommends \
        kali-tools-voip ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# distrobox may already be present in the Kali base; install if available, ignore otherwise.
RUN apt-get update && (apt-get install -y --no-install-recommends distrobox || true) \
    && rm -rf /var/lib/apt/lists/*

# Goshenite marker + convenience alias file for distrobox-exported shells.
RUN mkdir -p /usr/share/goshenite \
    && echo '{"lab":"voip","kali_tools":"kali-tools-voip"}' > /usr/share/goshenite/lab-info.json \
    && printf '# Goshenite voip lab\nalias goshenite-lab="echo voip (kali-tools-voip)"\n' > /etc/profile.d/goshenite-voip-alias.sh

CMD ["/bin/bash"]
