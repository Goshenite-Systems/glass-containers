# syntax=docker/dockerfile:1
# Goshenite lab: sniffing-spoofing
# Base: Kali rolling. Installs kali-tools-sniffing-spoofing so the sniffing-spoofing bundle's
# unpackaged (non-Fedora) tools are reachable via `distrobox enter sniffing-spoofing`.
# Auto-generated by generate-labs.py — do not edit by hand.
FROM kalilinux/kali-rolling:latest

ENV DEBIAN_FRONTEND=noninteractive \
    GOSHENITE_LAB=sniffing-spoofing

RUN apt-get update && apt-get install -y --no-install-recommends \
        kali-tools-sniffing-spoofing ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# distrobox may already be present in the Kali base; install if available, ignore otherwise.
RUN apt-get update && (apt-get install -y --no-install-recommends distrobox || true) \
    && rm -rf /var/lib/apt/lists/*

# Goshenite marker + convenience alias file for distrobox-exported shells.
RUN mkdir -p /usr/share/goshenite \
    && echo '{"lab":"sniffing-spoofing","kali_tools":"kali-tools-sniffing-spoofing"}' > /usr/share/goshenite/lab-info.json \
    && printf '# Goshenite sniffing-spoofing lab\nalias goshenite-lab="echo sniffing-spoofing (kali-tools-sniffing-spoofing)"\n' > /etc/profile.d/goshenite-sniffing-spoofing-alias.sh

CMD ["/bin/bash"]
