# syntax=docker/dockerfile:1
# Goshenite lab: fuzzing
# Base: Kali rolling. Installs kali-tools-fuzzing so the fuzzing bundle's
# unpackaged (non-Fedora) tools are reachable via `distrobox enter fuzzing`.
# Auto-generated by generate-labs.py — do not edit by hand.
FROM kalilinux/kali-rolling:latest

ENV DEBIAN_FRONTEND=noninteractive \
    GOSHENITE_LAB=fuzzing

RUN apt-get update && apt-get install -y --no-install-recommends \
        kali-tools-fuzzing ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# distrobox may already be present in the Kali base; install if available, ignore otherwise.
RUN apt-get update && (apt-get install -y --no-install-recommends distrobox || true) \
    && rm -rf /var/lib/apt/lists/*

# Goshenite marker + convenience alias file for distrobox-exported shells.
RUN mkdir -p /usr/share/goshenite \
    && echo '{"lab":"fuzzing","kali_tools":"kali-tools-fuzzing"}' > /usr/share/goshenite/lab-info.json \
    && printf '# Goshenite fuzzing lab\nalias goshenite-lab="echo fuzzing (kali-tools-fuzzing)"\n' > /etc/profile.d/goshenite-fuzzing-alias.sh

CMD ["/bin/bash"]
