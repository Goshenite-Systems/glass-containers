# syntax=docker/dockerfile:1
# Goshenite lab: web
# Base: Kali rolling. Installs kali-tools-web so the web bundle's
# unpackaged (non-Fedora) tools are reachable via `distrobox enter web`.
# Auto-generated by generate-labs.py — do not edit by hand.
FROM kalilinux/kali-rolling:latest

ENV DEBIAN_FRONTEND=noninteractive \
    GOSHENITE_LAB=web

RUN apt-get update && apt-get install -y --no-install-recommends \
        kali-tools-web ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# distrobox may already be present in the Kali base; install if available, ignore otherwise.
RUN apt-get update && (apt-get install -y --no-install-recommends distrobox || true) \
    && rm -rf /var/lib/apt/lists/*

# Goshenite marker + convenience alias file for distrobox-exported shells.
RUN mkdir -p /usr/share/goshenite \
    && echo '{"lab":"web","kali_tools":"kali-tools-web"}' > /usr/share/goshenite/lab-info.json \
    && printf '# Goshenite web lab\nalias goshenite-lab="echo web (kali-tools-web)"\n' > /etc/profile.d/goshenite-web-alias.sh

CMD ["/bin/bash"]
