# syntax=docker/dockerfile:1
# Goshenite lab: identify
# Base: Kali rolling. Installs kali-tools-identify so the identify bundle's
# unpackaged (non-Fedora) tools are reachable via `distrobox enter identify`.
# Auto-generated by generate-labs.py — do not edit by hand.
FROM kalilinux/kali-rolling:latest

ENV DEBIAN_FRONTEND=noninteractive \
    GOSHENITE_LAB=identify

RUN apt-get update && apt-get install -y --no-install-recommends \
        kali-tools-identify ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# distrobox may already be present in the Kali base; install if available, ignore otherwise.
RUN apt-get update && (apt-get install -y --no-install-recommends distrobox || true) \
    && rm -rf /var/lib/apt/lists/*

# Goshenite marker + convenience alias file for distrobox-exported shells.
RUN mkdir -p /usr/share/goshenite \
    && echo '{"lab":"identify","kali_tools":"kali-tools-identify"}' > /usr/share/goshenite/lab-info.json \
    && printf '# Goshenite identify lab\nalias goshenite-lab="echo identify (kali-tools-identify)"\n' > /etc/profile.d/goshenite-identify-alias.sh

CMD ["/bin/bash"]
