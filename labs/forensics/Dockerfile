# syntax=docker/dockerfile:1
# Goshenite lab: forensics
# Base: Kali rolling. Installs kali-tools-forensics so the forensics bundle's
# unpackaged (non-Fedora) tools are reachable via `distrobox enter forensics`.
# Auto-generated by generate-labs.py — do not edit by hand.
FROM kalilinux/kali-rolling:latest

ENV DEBIAN_FRONTEND=noninteractive \
    GOSHENITE_LAB=forensics

RUN apt-get update && apt-get install -y --no-install-recommends \
        kali-tools-forensics ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# distrobox may already be present in the Kali base; install if available, ignore otherwise.
RUN apt-get update && (apt-get install -y --no-install-recommends distrobox || true) \
    && rm -rf /var/lib/apt/lists/*

# Goshenite marker + convenience alias file for distrobox-exported shells.
RUN mkdir -p /usr/share/goshenite \
    && echo '{"lab":"forensics","kali_tools":"kali-tools-forensics"}' > /usr/share/goshenite/lab-info.json \
    && printf '# Goshenite forensics lab\nalias goshenite-lab="echo forensics (kali-tools-forensics)"\n' > /etc/profile.d/goshenite-forensics-alias.sh

CMD ["/bin/bash"]
